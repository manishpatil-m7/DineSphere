// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  password     String
  role         String   @default("CUSTOMER") // ADMIN, MANAGER, KITCHEN, DELIVERY, CUSTOMER
  photo_url    String?
  points       Int      @default(0)
  is_active    Boolean  @default(true)
  dietary_pref String   @default("none") // none, veg, vegan
  allergies    String?
  notify_email Boolean  @default(true)
  notify_sms   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders         Order[]
  reservations   Reservation[]
  reviews        Review[]
  loyaltyAccount LoyaltyAccount?
  addresses      Address[]
}

model Dish {
  id           String   @id @default(uuid())
  name         String
  description  String?
  category     String   // Starters, Main Course, Desserts, Drinks
  price        Int      // integer rupees
  is_veg       Boolean  @default(true)
  image_url    String?
  rating       Float    @default(4.5)
  is_available Boolean  @default(true)
  is_archived  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CustomerOrder {
  id                String              @id @default(uuid())
  user_id           String
  status            String              @default("Placed") // Placed, Preparing, Ready, Served, Cancelled
  order_type        String              // Dine-in, Takeaway, Delivery
  table_number      Int?
  address           String?
  notes             String?
  subtotal          Int
  discount          Int                 @default(0)
  total             Int
  coupon_code       String?
  payment_method    String              @default("UPI") // UPI, Card, Cash
  payment_status    String              @default("Paid") // Paid, Pending
  points_earned     Int                 @default(0)
  created_at        DateTime            @default(now())
  estimated_minutes Int                 @default(25)
  cancel_reason     String?
  admin_notes       String?
  status_changed_by_admin Boolean       @default(false)
  items             CustomerOrderItem[]

  @@index([created_at])
  @@index([user_id])
  @@index([status])
}

model CustomerOrderItem {
  id       String        @id @default(uuid())
  order_id String
  dish_id  String
  name     String
  price    Int
  quantity Int
  note     String?
  order    CustomerOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
}

model CustomerReservation {
  id         String   @id @default(uuid())
  user_id    String
  date       String   // YYYY-MM-DD
  time_slot  String
  guests     Int
  table_id   String
  status     String   @default("Confirmed") // Confirmed, Cancelled, Completed
  created_at DateTime @default(now())
}

model FloorTable {
  id        String  @id @default(uuid())
  label     String  @unique // e.g. "A1"
  zone      String  // Lounge, Window, Family, Regular
  row_label String  // A to H
  col_index Int
  block     String  // left, center, right
  seats     Int     // 2, 4 or 6
  fee       Int     // rupees per table (300, 200, 100, 0)
  is_active Boolean @default(true)
}

model CinemaReservation {
  id              String   @id @default(uuid())
  user_id         String?
  guest_name      String?
  guest_phone     String?
  source          String   @default("online") // online, walk-in
  code            String   @unique // e.g. DS-7K3P9Q
  date            String   // YYYY-MM-DD
  time_slot       String   // e.g. "19:30"
  guests          Int
  occasion        String?
  special_request String?
  fee_total       Int
  payment_method  String
  status          String   @default("Confirmed") // Confirmed, Cancelled, Completed, Seated, No-show
  created_at      DateTime @default(now())

  tables          CinemaReservationTable[]

  @@index([date, time_slot])
  @@index([status])
}

model CinemaReservationTable {
  id              String            @id @default(uuid())
  reservation_id  String
  table_id        String
  table_label     String
  date            String
  time_slot       String
  active          Boolean           @default(true)
  active_slot_key String            @unique // "${table_id}_${date}_${time_slot}" while active

  reservation     CinemaReservation @relation(fields: [reservation_id], references: [id], onDelete: Cascade)
}

model TableHold {
  id           String   @id @default(uuid())
  user_id      String
  date         String
  time_slot    String
  table_ids    String   // JSON array of table ids
  table_labels String   // JSON array of table labels
  expires_at   DateTime
  created_at   DateTime @default(now())
}

model DiningTable {
  id     String @id @default(uuid())
  number Int    @unique
  seats  Int
}

model Favorite {
  id      String @id @default(uuid())
  user_id String
  dish_id String

  @@unique([user_id, dish_id])
}

model CustomerReview {
  id         String   @id @default(uuid())
  user_id    String
  order_id   String
  dish_id    String?
  rating     Int
  comment    String?
  is_hidden  Boolean  @default(false)
  admin_reply String?
  created_at DateTime @default(now())
}

model CustomerCoupon {
  id               String    @id @default(uuid())
  code             String    @unique
  description      String
  discount_percent Int
  min_order        Int
  usage_limit      Int?
  used_count       Int       @default(0)
  per_user_limit   Int       @default(1)
  valid_from       DateTime?
  expires_at       DateTime?
  is_active        Boolean   @default(true)
}

model CustomerNotification {
  id         String   @id @default(uuid())
  user_id    String?
  audience   String?
  title      String
  message    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
}

model SupportTicket {
  id         String   @id @default(uuid())
  user_id    String
  subject    String
  message    String
  status     String   @default("Open") // Open, Closed
  created_at DateTime @default(now())
}

model Address {
  id         String  @id @default(uuid())
  user_id    String
  label      String  // Home, Work, Other
  line1      String
  city       String
  pincode    String
  is_default Boolean @default(false)
  user       User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// --------------------------------------------------
// Existing tables preserved for admin/kitchen compatibility
// --------------------------------------------------
model MenuCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  image     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MenuItem[]
}

model MenuItem {
  id              String   @id @default(uuid())
  name            String
  description     String?
  price           Float
  image           String?
  isVegetarian    Boolean  @default(true)
  spiceLevel      Int      @default(0) // 0-3
  preparationTime Int      @default(15) // minutes
  allergens       String? // Comma-separated
  ingredients     String? // Comma-separated
  isFeatured      Boolean  @default(false)
  isPopular       Boolean  @default(false)
  isActive        Boolean  @default(true)
  categoryId      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category   MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
}

model Order {
  id                  String           @id @default(uuid())
  orderNumber         Int              @default(0)
  userId              String?
  type                String           // DINE_IN, TAKEAWAY, DELIVERY
  status              String           @default("PENDING") // PENDING, CONFIRMED, PREPARING, READY, OUT_FOR_DELIVERY, COMPLETED, CANCELLED
  tableId             String?
  deliveryAddress     String?
  specialInstructions String?
  subtotal            Float
  tax                 Float
  discount            Float            @default(0)
  deliveryFee         Float            @default(0)
  total               Float
  couponCode          String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user    User?            @relation(fields: [userId], references: [id])
  table   RestaurantTable? @relation(fields: [tableId], references: [id])
  items   OrderItem[]
  payment Payment?
}

model OrderItem {
  id                  String   @id @default(uuid())
  orderId             String
  menuItemId          String
  quantity            Int
  price               Float
  specialInstructions String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

model RestaurantTable {
  id        String   @id @default(uuid())
  number    Int      @unique
  capacity  Int
  location  String?
  status    String   @default("AVAILABLE") // AVAILABLE, RESERVED, OCCUPIED, CLEANING, UNAVAILABLE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders       Order[]
  reservations Reservation[]
}

model Reservation {
  id            String   @id @default(uuid())
  userId        String?
  customerName  String
  customerPhone String
  date          DateTime
  time          String
  guests        Int
  tableId       String
  status        String   @default("CONFIRMED") // CONFIRMED, CANCELLED, COMPLETED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User?           @relation(fields: [userId], references: [id])
  table RestaurantTable @relation(fields: [tableId], references: [id])
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String   @unique
  method        String   // CASH, CARD, UPI
  status        String   @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  amount        Float
  transactionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  discountType   String    // PERCENTAGE, FIXED
  discountValue  Float
  minOrderAmount Float     @default(0)
  maxDiscount    Float?
  usageLimit     Int?
  usedCount      Int       @default(0)
  startDate      DateTime?
  expiryDate     DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Review {
  id            String   @id @default(uuid())
  userId        String
  rating        Int      // 1-5
  comment       String?
  foodRating    Int?
  serviceRating Int?
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model InventoryItem {
  id            String   @id @default(uuid())
  name          String   @unique
  unit          String
  currentStock  Float    @default(0)
  minStock      Float    @default(5)
  maxStock      Float?
  costPerUnit   Float    @default(0)
  quantity      Float    @default(0)
  low_threshold Float    @default(5)
  cost_per_unit Float    @default(0)
  supplierId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  supplier     Supplier?              @relation(fields: [supplierId], references: [id])
  transactions InventoryTransaction[]
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  contact   String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items InventoryItem[]
}

model InventoryTransaction {
  id              String   @id @default(uuid())
  inventoryItemId String
  type            String   // IN, OUT, ADJUSTMENT
  quantity        Float
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
}

model LoyaltyAccount {
  id        String   @id @default(uuid())
  userId    String   @unique
  points    Int      @default(0)
  level     String   @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?  // null if admin notification
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   // ORDER, RESERVATION, INVENTORY, SYSTEM
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model AdminAction {
  id         String   @id @default(uuid())
  action     String
  entity     String
  entity_id  String?
  details    String?
  created_at DateTime @default(now())
}

model RestaurantSetting {
  id                     String   @id @default(uuid())
  restaurant_name        String   @default("DineSphere Luxury Dining")
  phone                  String   @default("+91 98765 43210")
  address                String   @default("Palms Boulevard, Marine Drive, Mumbai")
  tax_percent            Float    @default(5)
  points_per_rupees      Float    @default(10)
  reservation_slots      String   @default("[\"12:00\",\"13:30\",\"15:00\",\"18:30\",\"19:30\",\"20:30\",\"21:30\"]")
  max_days_ahead         Int      @default(14)
  hold_minutes           Int      @default(5)
  cancel_window_hours    Int      @default(2)
  max_tables_per_booking Int      @default(4)
  is_accepting_orders    Boolean  @default(true)
  updated_at             DateTime @updatedAt
}

model DishIngredient {
  id           String @id @default(uuid())
  dish_id      String
  item_id      String
  qty_per_dish Float
}

model TableBlock {
  id         String   @id @default(uuid())
  table_id   String
  date       String
  time_slot  String?
  reason     String
  created_at DateTime @default(now())
}

model TicketReply {
  id          String   @id @default(uuid())
  ticket_id   String
  author_role String
  message     String
  created_at  DateTime @default(now())
}

